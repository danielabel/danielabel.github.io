<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ (title + " — ") if title }}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Cormorant+Unicase:wght@300;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}{% if section %} data-section="{{ section }}"{% endif %}>
  {{ content | safe }}
<script>
  document.addEventListener('submit', async function(e) {
    const form = e.target.closest('.subscribe-form');
    if (!form) return;
    e.preventDefault();
    const email = form.querySelector('.subscribe-input').value;
    const pubId = form.dataset.beehiivPub;
    const formId = form.dataset.beehiivForm;
    try {
      await fetch(`https://subscribe-forms.beehiiv.com/api/v3/publications/${pubId}/subscriptions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, form_id: formId, utm_source: 'website' })
      });
    } catch(_) {}
    form.hidden = true;
    form.closest('.subscribe-block').querySelector('.subscribe-confirm').hidden = false;
  });
</script>
</body>
</html>
