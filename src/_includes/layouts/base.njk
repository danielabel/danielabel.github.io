<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ (title + " — ") if title }}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Cormorant+Unicase:wght@300;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}{% if section %} data-section="{{ section }}"{% endif %}>
  {{ content | safe }}
  <script>
    (function () {
      function labelBeehiivIframes() {
        document.querySelectorAll('.subscribe-block iframe').forEach(function (frame) {
          if (!frame.title) frame.title = 'Newsletter subscription form';
        });
      }
      labelBeehiivIframes();
      new MutationObserver(labelBeehiivIframes).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
</body>
</html>
