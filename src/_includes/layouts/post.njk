---
layout: layouts/base.njk
---
<main class="post-page">
  <a href="/{{ section }}/" class="post-back">← {{ section | capitalize }}</a>
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">{{ page.date | readableDate }}</div>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <div class="subscribe-block">
    <p class="subscribe-label">Register for updates and new articles</p>
    <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="c57448c1-a19e-4653-ad82-bdcb613abf42"></script>
  </div>
</main>
