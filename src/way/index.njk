---
layout: layouts/section-index.njk
section: way
title: The Way
---
<a href="/" class="section-back">← Home</a>

<header>
  <h1 class="section-title">The Way</h1>
  <p class="section-description">The inner life of technical leadership — why we lead, who we become, what the path asks of us.</p>
</header>

{% set posts = collections.way %}
{% if posts and posts.length %}
<ul class="post-list">
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <div class="post-date">{{ post.date | readableDate }}</div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="section-description">Words are coming.</p>
{% endif %}
