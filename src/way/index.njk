---
layout: layouts/section-index.njk
section: way
title: The Way
---
<a href="/" class="section-back">← Home</a>

<header>
  <h1 class="section-title">The Way</h1>
  <p class="section-description">The inner life of technical leadership — why we lead, who we become, what the path asks of us.</p>
</header>

{% set posts = collections.way %}
{% if posts and posts.length %}
<ul class="post-list">
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <div class="post-date">{{ post.date | readableDate }}</div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="section-description">Words are coming.</p>
{% endif %}

<div class="subscribe-block">
  <p class="subscribe-label">Register for updates and new articles</p>
  <form class="subscribe-form" data-beehiiv-pub="67728396-806b-48bd-a082-3e11ff06a4a5" data-beehiiv-form="c57448c1-a19e-4653-ad82-bdcb613abf42">
    <input class="subscribe-input" type="email" placeholder="your@email.com" required autocomplete="email" />
    <button class="subscribe-btn" type="submit">Subscribe</button>
  </form>
  <p class="subscribe-confirm" hidden>Thank you — you're on the list.</p>
</div>
